{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "https://gist.githubusercontent.com/seb-schulz/86ae2e7ef1de082149821a507f111aa8/raw/renovate.json"
  ],
  "ansible-galaxy": {
    "enabled": true
  },
  "pep621": {
    "lockFileMaintenance": {
      "enabled": true
    }
  },
  "packageRules": [
    {
      "description": "Disable pinning for regex manager Docker images",
      "matchManagers": ["regex"],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Docker image versions in Ansible defaults",
      "managerFilePatterns": [
        "roles/*/defaults/main.yaml",
        "roles/*/defaults/main.yml"
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9._-]+_image):\\s+(?<packageName>[^:]+):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
